  <process id="ohaloprocess" name="query creation" isExecutable="true" flowable:candidateStarterGroups="flowableUser">
    <documentation>Create a query for unstructured data, and retrieve path to files that satisfy the query.</documentation>
    <extensionElements>
      <design:stencilid><![CDATA[BPMNDiagram]]></design:stencilid>
