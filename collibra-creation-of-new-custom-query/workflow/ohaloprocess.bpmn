    <userTask id="formTask1" name="Creation of Condition form" flowable:candidateUsers="user(${initiator})" flowable:formKey="labelCreation" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:candidatestype><![CDATA[all]]></design:candidatestype>
        <design:activestaterendering><![CDATA[fullAccess]]></design:activestaterendering>
        <design:completedstaterendering><![CDATA[hidden]]></design:completedstaterendering>
        <design:taskinputmappingtype><![CDATA[allowed]]></design:taskinputmappingtype>
      </extensionElements>
    </userTask>
    <scriptTask id="scriptTask1" name="creation of query" scriptFormat="groovy" flowable:autoStoreVariables="false">
      <extensionElements>
        <design:stencilid><![CDATA[ScriptTask]]></design:stencilid>
      </extensionElements>
      <script><![CDATA[import com.collibra.dgc.core.api.dto.instance.asset.AddAssetRequest;
import com.collibra.dgc.core.api.component.instance.AssetApi;
import com.collibra.dgc.core.api.dto.instance.asset.SetAssetRelationsRequest;
import com.collibra.dgc.core.api.dto.query.outputmodule.ExportJSONRequest;
import com.collibra.dgc.core.api.dto.instance.comment.AddCommentRequest;
import com.collibra.dgc.core.api.dto.instance.asset.SetAssetAttributesRequest;
import com.collibra.dgc.core.api.dto.instance.attribute.AddAttributeRequest;
import com.collibra.dgc.core.api.dto.instance.relation.AddRelationRequest;
import com.fasterxml.jackson.databind.ObjectMapper
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse
import java.net.URI

import java.net.URLEncoder;
import java.nio.charset.StandardCharsets;

def annotator = execution.getVariable("annotator")
def extractor = execution.getVariable("extractor")
def label = execution.getVariable("label")
def requestPath = execution.getVariable("requestPath")
def apiBaseUrl = execution.getVariable("apiBaseUrl")
def authToken = execution.getVariable("authToken")
def maxResults = execution.getVariable("maxResults") as Integer

def addAttributeToAsset(assetUuid,attributeValue,attributeTypeUuid) {
if (attributeValue == null){
return;
}

  attributeApi.addAttribute(AddAttributeRequest.builder()
		.assetId(assetUuid)
		.typeId(string2Uuid(attributeTypeUuid))
		.value(attributeValue.toString())
		.build())
}

def queryid=assetApi.addAsset(AddAssetRequest.builder()
                  .displayName(conditionName)
                  .domainId(string2Uuid(queryDomain))
                  .name(conditionName)
                  .typeId(string2Uuid(query_asset_type_id))              
                  .build()).getId()

loggerApi.info("query id : {$queryid}")

if (annotator) 
   {
annotator_id=string2Uuid(annotator)
annotator_asset = assetApi.getAsset(annotator_id);
annotatorName = annotator_asset.getName();
} else 
   {
     annotatorName=''
   }

if (extractor) 
   {
extractor_id=string2Uuid(extractor)
extractor_asset = assetApi.getAsset(extractor_id);
extractorName = extractor_asset.getName();
}  else {
     extractorName=''
   }

if (label) 
{
label_id=string2Uuid(label)
label_asset = assetApi.getAsset(label_id);
loggerApi.info("#### : {$label_asset}") 
labelName = label_asset.getName();
loggerApi.info("Label Name : {$labelName}"); 
} else {
  labelName=''
}

query_param=''
def params=['labels.name:': labelName, 'annotators.name:': annotatorName, 'extractors.name:':extractorName]
params.eachWithIndex {key,value,i->
   if (value) {
       new_value='"'+value +'"'
       loggerApi.info("new : {$new_value}"); 
       if (i in [0]) {query_param+=key+ new_value}  else 
                 if (i in [1,2]){query_param+=' AND '+key+ new_value}
        
     
   }}
     

loggerApi.info("query : {$query_param}") 


description="The query is: "+query_param
descrid="00000000-0000-0000-0000-000000003114"
addAttributeToAsset(queryid,description,descrid)
locationid="00000000-0000-0000-0000-000000000203"
//  curl -X GET "https://collibra-demo-integration.dataxray.io/api/v1/files?q=labels.name%3A+%22CV%22+AND+annotators.name%3A%22Confidential%22" \
//  -H "Authorization: Bearer "


def encodedValue = URLEncoder.encode(query_param, StandardCharsets.UTF_8.toString())

loggerApi.info("encoded : {$encodedValue}")   


requestPath=apiBaseUrl+requestPath+encodedValue;


def client = HttpClient.newHttpClient()
def request = HttpRequest.newBuilder()
    .uri(URI.create(requestPath))
    .header("Authorization", "Bearer " + authToken)
    .header("Accept", "application/x-ndjson")
    .timeout(java.time.Duration.ofSeconds(60))
    .GET()
    .build()

def response = client.send(request, HttpResponse.BodyHandlers.ofInputStream())
loggerApi.info("DXR query status: " + response.statusCode())
if (response.statusCode() >= 400) {
    throw new RuntimeException("DXR query failed: HTTP " + response.statusCode())
}

def mapper = new ObjectMapper()
def files = [['filename', 'path']]
def count = 0
def skipped = 0

response.body().withCloseable { input ->
    def records = mapper.readerFor(Map).readValues(input)
    while (records.hasNextValue() && count < maxResults) {
        try {
            def obj = records.nextValue()
            files << [obj.fileName, obj.path]
            count++
        } catch (Exception e) {
            skipped++
            loggerApi.warn("Skipping malformed JSONL record: " + e.message)
        }
    }
}

loggerApi.info("DXR query returned " + count + " files (skipped " + skipped + " malformed records)")

execution.setVariable("files", files)
execution.setVariable("count", count)

import groovy.xml.MarkupBuilder

def writer = new StringWriter()
def html = new MarkupBuilder(writer)

html.ul {
    files.each { file ->
        li(file)
    }
}
writer_ready=writer.toString()

addAttributeToAsset(queryid,files,locationid)
execution.setVariable("writer_ready",writer_ready); 













                 ]]></script>
    </scriptTask>
    <serviceTask id="httpTask1" name="HTTP" flowable:async="true" flowable:parallelInSameTransaction="false" flowable:type="http">
      <documentation>STUB — currently disconnected from the main flow. NOT a drop-in replacement for the inline HttpClient call in scriptTask1: Flowable HTTP service tasks buffer the entire response into a string-valued process variable, which defeats streaming. The DXR /api/v1/files endpoint returns JSONL, so the inline HttpClient with BodyHandlers.ofInputStream() in scriptTask1 is the correct architecture for that call. Kept as a placeholder for future non-streaming HTTP integrations against connection ${connectionname}; otherwise a candidate for deletion.</documentation>
