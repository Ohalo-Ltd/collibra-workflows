          <flowable:string><![CDATA[406,400]]></flowable:string>
        </flowable:field>
        <design:stencilid><![CDATA[HttpTask]]></design:stencilid>
        <design:http-connection-name><![CDATA[${connectionname}]]></design:http-connection-name>
      </extensionElements>
    </serviceTask>
    <userTask id="FormTask_1" name="Query results" flowable:candidateUsers="user(${initiator})">
      <documentation>There are ${count} of files. 
${writer_ready}

</documentation>
